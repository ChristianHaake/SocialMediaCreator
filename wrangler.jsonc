{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socialmediacreator",
  "compatibility_date": "2026-06-10",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "stage": {
      "routes": [
        { "pattern": "stage.smc.haak3.de", "custom_domain": true }
      ]
    }
  }
}
